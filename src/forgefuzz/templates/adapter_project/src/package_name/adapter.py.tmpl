from __future__ import annotations

import json
import random
import sys
from dataclasses import replace
from importlib import resources
from pathlib import Path

from forgefuzz.generate import OpSpec, RandomGraphGenerator
from forgefuzz.model import ExecutionResult, FailureKind, Graph, Node, ProgramArtifact, TensorType
from forgefuzz.plugin import LanguageAdapter


class __ADAPTER_CLASS__(LanguageAdapter):
    """Reference adapter. Replace its emitter with your real toolchain."""

    name = "__ADAPTER_NAME__"

    def __init__(self):
        catalog_file = resources.files(__package__).joinpath("api_catalog.json")
        self.catalog = json.loads(catalog_file.read_text(encoding="utf-8"))
        self.operations = tuple(self.catalog["operations"])
        specs = tuple(
            OpSpec(
                name, int(rule["arity"]), dtypes=tuple(rule.get("dtypes", ())),
            )
            for name, rule in self.catalog["operations"].items()
        )
        self.generator = RandomGraphGenerator(specs, min_nodes=3, max_nodes=8)

    def generate(self, rng: random.Random) -> Graph:
        tensor = TensorType("float32", (4,))
        return self.generator.generate(
            rng, {"x": tensor, "y": tensor}, {"adapter": self.name},
        )

    def mutate(self, graph: Graph, rng: random.Random) -> Graph:
        index = rng.randrange(len(graph.nodes))
        nodes = list(graph.nodes)
        choices = [op for op in self.operations if op != nodes[index].op]
        nodes[index] = replace(nodes[index], op=rng.choice(choices))
        return replace(graph, nodes=tuple(nodes))

    def validate(self, graph: Graph):
        available = set(graph.inputs)
        for node in graph.nodes:
            rule = self.catalog["operations"].get(node.op)
            if rule is None:
                yield f"unknown operation: {node.op}"
            elif len(node.inputs) != rule["arity"]:
                yield f"{node.id}: expected {rule['arity']} inputs"
            unknown = set(node.inputs) - available
            if unknown:
                yield f"{node.id}: unknown values {sorted(unknown)}"
            available.add(node.id)

    def emit(self, graph: Graph, output_dir: Path) -> ProgramArtifact:
        output_dir.mkdir(parents=True, exist_ok=True)
        expressions = {
            "add": "[a + b for a, b in zip({0}, {1})]",
            "mul": "[a * b for a, b in zip({0}, {1})]",
            "maximum": "[max(a, b) for a, b in zip({0}, {1})]",
        }
        values = {"x": "x", "y": "y"}
        lines = [
            "import json",
            "x = [1.0, -2.0, 3.0, 4.0]",
            "y = [2.0, 3.0, -1.0, 0.5]",
        ]
        for node in graph.nodes:
            left, right = (values[name] for name in node.inputs)
            expression = expressions[node.op].format(left, right)
            lines.extend((f"# forgefuzz-api: {node.op}", f"{node.id} = {expression}"))
            values[node.id] = node.id
        lines.append(f"print(json.dumps({{'actual': {values[graph.outputs[0]]}}}))")
        source = "\n".join(lines) + "\n"
        entrypoint = output_dir / "program.py"
        entrypoint.write_text(source, encoding="utf-8")
        return ProgramArtifact(
            entrypoint, (entrypoint,), run_command=(sys.executable, str(entrypoint.resolve())),
            metadata={"operations": [node.op for node in graph.nodes]},
        )

    def oracle(self, artifact: ProgramArtifact, result: ExecutionResult) -> ExecutionResult:
        if not result.success or result.run is None:
            return result
        try:
            payload = json.loads(result.run.log_tail.strip().splitlines()[-1])
            actual = payload["actual"]
        except (ValueError, KeyError, IndexError) as exc:
            return replace(result, kind=FailureKind.OUTPUT_MISMATCH, stage="oracle", message=f"bad output: {exc}")
        if len(actual) != 4 or not all(isinstance(value, (int, float)) for value in actual):
            return replace(result, kind=FailureKind.OUTPUT_MISMATCH, stage="oracle", message="output invariant failed")
        return result

    def observe(self, artifact: ProgramArtifact, result: ExecutionResult):
        yield f"result:{result.kind.value}"
        for operation in artifact.metadata["operations"]:
            yield f"api:{operation}"
