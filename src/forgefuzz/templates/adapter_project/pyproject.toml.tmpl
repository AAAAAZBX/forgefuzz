[build-system]
requires = ["setuptools>=68"]
build-backend = "setuptools.build_meta"

[project]
name = "__PROJECT_NAME__"
version = "0.1.0"
description = "A __ADAPTER_NAME__ fuzzing adapter built with ForgeFuzz"
requires-python = ">=3.10"
dependencies = ["forgefuzz>=0.1.0"]

[project.optional-dependencies]
dev = ["pytest>=8"]

[project.entry-points."forgefuzz.adapters"]
__ADAPTER_NAME__ = "__PACKAGE_NAME__.adapter:__ADAPTER_CLASS__"

[tool.setuptools.packages.find]
where = ["src"]

[tool.setuptools.package-data]
__PACKAGE_NAME__ = ["api_catalog.json"]

[tool.pytest.ini_options]
testpaths = ["tests"]
